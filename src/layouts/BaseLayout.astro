---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, jsonLd, noindex = false } = Astro.props;

// Determine canonical URL: explicitly provided OR current URL without search params
const canonicalURL = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();

const getPath = (path: string) => {
  const base = import.meta.env.BASE_URL;
  return `${base}/${path}`.replace(/\/\/+/g, '/');
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getPath("favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title} | Konfliktlotse</title>

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Konfliktlotse`} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Konfliktlotse`} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={new URL(ogImage, Astro.site).toString()} />}

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <style is:global>
      :root {
        --primary: #2D6A4F;
        --primary-light: #40916C;
        --primary-dark: #1B4332;
        --accent: #F4A261;
        --accent-light: #F8B878;
        --bg: #F8F9FA;
        --bg-white: #FFFFFF;
        --text: #1B1B1B;
        --text-light: #5A5A5A;
        --border: #E0E0E0;
        --radius: 12px;
        --radius-sm: 8px;
        --shadow: 0 2px 8px rgba(0,0,0,0.06);
        --max-width: 720px;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a {
        color: var(--primary);
        text-decoration: none;
        transition: color 0.15s;
      }
      a:hover {
        color: var(--primary-dark);
      }
      h1, h2, h3, h4 {
        line-height: 1.3;
        color: var(--text);
      }
      h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; }
      h2 { font-size: 1.35rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem; }
      h3 { font-size: 1.1rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; }
      p { margin-bottom: 1rem; }
      ::selection {
        background: var(--primary-light);
        color: white;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a href={getPath("")} class="logo">
          <span class="logo-icon">🕊️</span>
          <span class="logo-text">Konfliktlotse</span>
        </a>
        <nav class="nav">
          <a href={getPath("")}>Start</a>
          <a href={getPath("konflikt/")}>Konflikte</a>
          <a href={getPath("ratgeber/")}>Ratgeber</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p>Vom Konflikt zum klaren Gespräch – mit konkreten Worten und einem Plan.</p>
        <div class="footer-links">
          <a href={getPath("konflikt/")}>Alle Konflikte</a>
          <a href={getPath("ratgeber/")}>Alle Ratgeber</a>
          <a href={getPath("hilfe-in-krisen/")}>Hilfe in Krisen</a>
          <a href={getPath("impressum/")}>Impressum</a>
          <a href={getPath("datenschutz/")}>Datenschutz</a>
        </div>
      </div>
    </footer>

    <style is:global>
      .header {
        background: var(--bg-white);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(4px);
        background: rgba(255,255,255,0.95);
      }
      .header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        font-weight: 700;
        font-size: 1.1rem;
      }
      .logo:hover { color: var(--primary); }
      .logo-icon { font-size: 1.3rem; }
      .nav {
        display: flex;
        gap: 1rem;
      }
      .nav a {
        color: var(--text-light);
        font-size: 0.9rem;
        font-weight: 500;
      }
      .nav a:hover {
        color: var(--primary);
      }
      main {
        flex: 1;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1rem;
        width: 100%;
      }
      .footer {
        background: var(--bg-white);
        border-top: 1px solid var(--border);
        padding: 1.5rem 1rem;
        text-align: center;
        margin-top: auto;
      }
      .footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }
      .footer p {
        color: var(--text-light);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
      }
      .footer-links {
        margin-top: 0.5rem;
        font-size: 0.8rem;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
    </style>
  </body>
</html>
