---
import { ADS_ENABLED, ADSENSE_CLIENT, GA_ENABLED } from '../config/site';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: string;
  noindex?: boolean;
  /** Vollständiger <title> ohne angehängten Markennamen (z. B. Startseite). */
  fullTitle?: string;
  /** Kein AdSense-Script auf dieser Seite (Krisenhilfe, Rechtstexte, 404, sensible Themen). */
  noAds?: boolean;
  /** Open-Graph-Typ, z. B. `article` für Ratgeber. */
  ogType?: string;
}

const { title, description, canonical, ogImage = '/og/konfliktlotse.png', jsonLd, noindex = false, fullTitle, noAds = false, ogType = 'website' } = Astro.props;
const loadAds = ADS_ENABLED && !noAds && !noindex;

// Google kürzt Descriptions bei ~155–160 Zeichen: auf ganze Sätze kürzen, sonst an einer Wortgrenze.
const DESC_MAX = 158;
function fitDescription(text: string): string {
  const clean = text.replace(/\s+/g, ' ').trim();
  if (clean.length <= DESC_MAX) return clean;
  let out = '';
  for (const sentence of clean.split(/(?<=[.!?])\s+/)) {
    if ((out + ' ' + sentence).trim().length > DESC_MAX) break;
    out = (out + ' ' + sentence).trim();
  }
  if (out.length >= 70) return out;
  const cut = clean.slice(0, DESC_MAX - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:–-]$/, '') + '…';
}
const metaDescription = fitDescription(description);
// Google kürzt Titel bei rund 60 Zeichen: Markenzusatz nur anhängen, wenn er noch passt.
const BRAND_SUFFIX = ' | Konfliktlotse';
const TITLE_MAX = 60;
const rawTitle = fullTitle || `${title}${BRAND_SUFFIX}`;
const pageTitle = rawTitle.length > TITLE_MAX && rawTitle.endsWith(BRAND_SUFFIX)
  ? rawTitle.slice(0, -BRAND_SUFFIX.length)
  : rawTitle;

// Determine canonical URL: explicitly provided OR current URL without search params
const canonicalURL = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();

const getPath = (path: string) => {
  const base = import.meta.env.BASE_URL;
  return `${base}/${path}`.replace(/\/\/+/g, '/');
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getPath("favicon.svg")} />
    <link rel="icon" type="image/png" sizes="96x96" href={getPath("favicon-96.png")} />
    <link rel="icon" type="image/png" sizes="48x48" href={getPath("favicon-48.png")} />
    <link rel="icon" type="image/png" sizes="32x32" href={getPath("favicon-32.png")} />
    <link rel="apple-touch-icon" href={getPath("apple-touch-icon.png")} />
    <meta name="theme-color" content="#2D6A4F" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Konfliktlotse" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />}

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {loadAds && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}

    <style is:global>
      :root {
        --primary: #2D6A4F;
        --primary-light: #40916C;
        --primary-dark: #1B4332;
        --accent: #F4A261;
        --accent-light: #F8B878;
        --bg: #F8F9FA;
        --bg-white: #FFFFFF;
        --text: #1B1B1B;
        --text-light: #5A5A5A;
        --border: #E0E0E0;
        --radius: 12px;
        --radius-sm: 8px;
        --shadow: 0 2px 8px rgba(0,0,0,0.06);
        --max-width: 720px;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a {
        color: var(--primary);
        text-decoration: none;
        transition: color 0.15s;
      }
      a:hover {
        color: var(--primary-dark);
      }
      h1, h2, h3, h4 {
        line-height: 1.3;
        color: var(--text);
      }
      h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; }
      h2 { font-size: 1.35rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem; }
      h3 { font-size: 1.1rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; }
      p { margin-bottom: 1rem; }
      ::selection {
        background: var(--primary-light);
        color: white;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a href={getPath("")} class="logo">
          <span class="logo-icon">🕊️</span>
          <span class="logo-text">Konfliktlotse</span>
        </a>
        <nav class="nav">
          <a href={getPath("")}>Start</a>
          <a href={getPath("konflikt/")}>Konflikte</a>
          <a href={getPath("ratgeber/")}>Ratgeber</a>
          <a href={getPath("methoden/")}>Methoden</a>
          <a href={getPath("spiel/")} class="nav-wide">Üben</a>
          <a href={getPath("suche/")} class="nav-search" aria-label="Suche">🔍</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p>Vom Konflikt zum klaren Gespräch – mit konkreten Worten und einem Plan.</p>
        <div class="footer-links">
          <a href={getPath("konflikt/")}>Alle Konflikte</a>
          <a href={getPath("ratgeber/")}>Alle Ratgeber</a>
          <a href={getPath("methoden/")}>Methoden</a>
          <a href={getPath("themen/")}>Themen</a>
          <a href={getPath("spiel/gespraechstrainer/")}>Gesprächs-Trainer</a>
          <a href={getPath("spiel/eskalations-check/")}>Eskalations-Check</a>
          <a href={getPath("spiel/konflikttyp/")}>Konflikttyp-Test</a>
          <a href={getPath("vorlagen/")}>Vorlagen</a>
          <a href={getPath("glossar/")}>Glossar</a>
          <a href={getPath("hilfe-in-krisen/")}>Hilfe in Krisen</a>
          <a href={getPath("ueber-uns/")}>Über uns</a>
          <a href={getPath("kontakt/")}>Kontakt</a>
          <a href={getPath("impressum/")}>Impressum</a>
          <a href={getPath("datenschutz/")}>Datenschutz</a>
          {GA_ENABLED && <a href={getPath("datenschutz/")} data-consent-reset>Datenschutz-Einstellungen</a>}
        </div>
      </div>
    </footer>

    <style is:global>
      .header {
        background: var(--bg-white);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(4px);
        background: rgba(255,255,255,0.95);
      }
      .header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        font-weight: 700;
        font-size: 1.1rem;
      }
      .logo:hover { color: var(--primary); }
      .logo-icon { font-size: 1.3rem; }
      .nav {
        display: flex;
        gap: 1rem;
      }
      .nav a {
        color: var(--text-light);
        font-size: 0.9rem;
        font-weight: 500;
      }
      .nav a:hover {
        color: var(--primary);
      }
      @media (max-width: 520px) {
        .nav { gap: 0.8rem; }
        .nav a { font-size: 0.85rem; }
        .nav a:first-child { display: none; } /* Logo führt bereits zur Startseite */
        .nav a.nav-wide { display: none; }
        .header-inner { gap: 0.75rem; }
        .logo { font-size: 1rem; }
      }
      @media (max-width: 390px) {
        .header-inner { padding: 0.75rem 0.75rem; }
        .logo { font-size: 0.95rem; gap: 0.3rem; }
        .nav { gap: 0.6rem; }
        .nav a { font-size: 0.8rem; }
      }
      @media print {
        .header, .footer, .ad-slot, .feedback-widget, .breadcrumbs, .no-print { display: none !important; }
        body { background: #fff; }
        main { padding: 0; max-width: none; }
        a { color: inherit; text-decoration: none; }
      }
      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
      }
      main {
        flex: 1;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1rem;
        width: 100%;
      }
      .footer {
        background: var(--bg-white);
        border-top: 1px solid var(--border);
        padding: 1.5rem 1rem;
        text-align: center;
        margin-top: auto;
      }
      .footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }
      .footer p {
        color: var(--text-light);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
      }
      .footer-links {
        margin-top: 0.5rem;
        font-size: 0.8rem;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
    </style>
    <Analytics disabled={noAds} />
  </body>
</html>
