---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories/index.js';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Ratgeber"
  fullTitle="Ratgeber Konflikte: Ursachen und Lösungen | Konfliktlotse"
  description="Ratgeber zu Alltagskonflikten: warum Streit mit Partner:in, Eltern, Chef:in oder Nachbar:in entsteht, typische Fehler, langfristige Lösungen und Antworten auf häufige Fragen."
>
  <section>
    <h1>Alle Ratgeber</h1>
    <p class="page-desc">
      Verstehe die Dynamik hinter deinen Konflikten und finde langfristige Lösungen.
    </p>

    <div class="category-list">
      {
        categories.map(cat => (
          <div class="cat-block">
            <a href={`${baseUrl}/ratgeber/${cat.id}/`} class="cat-block-header">
              <span class="cat-block-icon">{cat.icon}</span>
              <span class="cat-block-name">{cat.name}</span>
              <span class="cat-block-arrow">→</span>
            </a>
            <div class="conflict-list">
              {
                cat.conflicts.map(con => (
                  <a href={`${baseUrl}/ratgeber/${cat.id}/${con.slug}/`} class="conflict-link">
                    <span>{con.icon}</span>
                    <span>{con.article?.title || con.title}</span>
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-desc {
    color: var(--text-light);
    margin-bottom: 2rem;
  }
  .category-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .cat-block {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cat-block-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    transition: background 0.15s;
  }
  .cat-block-header:hover {
    background: #E8F5E9;
  }
  .cat-block-icon {
    font-size: 1.5rem;
  }
  .cat-block-arrow {
    margin-left: auto;
    color: var(--text-light);
  }
  .conflict-list {
    display: flex;
    flex-direction: column;
  }
  .conflict-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text);
    font-size: 0.95rem;
    transition: background 0.15s;
    text-decoration: none;
  }
  .conflict-link:first-child {
    border-top: none;
  }
  .conflict-link:hover {
    background: var(--bg);
    color: var(--primary);
  }
</style>