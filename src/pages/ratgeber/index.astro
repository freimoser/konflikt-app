---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories, getAllConflicts } from '../../data/categories/index.js';

// „Neu im Ratgeber“: zuletzt veröffentlichte bzw. aktualisierte Artikel (echte Inhaltsdaten, kein Build-Datum)
const newest = getAllConflicts()
  .map(c => ({ ...c, date: c.updated || c.published || '2026-08-03' }))
  .sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title, 'de'))
  .slice(0, 6);
const fmt = (d) => new Date(d).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Ratgeber"
  fullTitle="Ratgeber Konflikte: Ursachen und Lösungen | Konfliktlotse"
  description="Ratgeber zu Alltagskonflikten: warum Streit mit Partner:in, Eltern, Chef:in oder Nachbar:in entsteht, typische Fehler, langfristige Lösungen und Antworten auf häufige Fragen."
>
  <Breadcrumbs crumbs={[{ label: 'Start', url: '/' }, { label: 'Ratgeber' }]} />
  <section>
    <h1>Alle Ratgeber</h1>
    <p class="page-desc">
      Verstehe die Dynamik hinter deinen Konflikten und finde langfristige Lösungen.
    </p>

    <section class="newest" aria-labelledby="neu">
      <h2 id="neu">Neu im Ratgeber</h2>
      <ul>
        {newest.map(c => (
          <li>
            <a href={`${baseUrl}/ratgeber/${c.category}/${c.slug}/`}>{c.article?.title || c.title}</a>
            <span class="newest-meta">{c.categoryName} · <time datetime={c.date}>{fmt(c.date)}</time></span>
          </li>
        ))}
      </ul>
    </section>

    <h2 class="all-heading">Alle Ratgeber nach Bereich</h2>
    <div class="category-list">
      {
        categories.map(cat => (
          <div class="cat-block">
            <a href={`${baseUrl}/ratgeber/${cat.id}/`} class="cat-block-header">
              <span class="cat-block-icon" aria-hidden="true">{cat.icon}</span>
              <span class="cat-block-name">{cat.name}</span>
              <span class="cat-block-arrow">→</span>
            </a>
            <div class="conflict-list">
              {
                cat.conflicts.map(con => (
                  <a href={`${baseUrl}/ratgeber/${cat.id}/${con.slug}/`} class="conflict-link">
                    <span>{con.icon}</span>
                    <span>{con.article?.title || con.title}</span>
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .newest { background: var(--bg-white); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 2rem; }
  .newest h2 { margin-top: 0; font-size: 1.15rem; }
  .newest ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .newest a { font-weight: 600; }
  .newest-meta { display: block; font-size: 0.8rem; color: var(--text-light); }
  .all-heading { font-size: 1.15rem; }
  .page-desc {
    color: var(--text-light);
    margin-bottom: 2rem;
  }
  .category-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .cat-block {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cat-block-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    transition: background 0.15s;
  }
  .cat-block-header:hover {
    background: #E8F5E9;
  }
  .cat-block-icon {
    font-size: 1.5rem;
  }
  .cat-block-arrow {
    margin-left: auto;
    color: var(--text-light);
  }
  .conflict-list {
    display: flex;
    flex-direction: column;
  }
  .conflict-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text);
    font-size: 0.95rem;
    transition: background 0.15s;
    text-decoration: none;
  }
  .conflict-link:first-child {
    border-top: none;
  }
  .conflict-link:hover {
    background: var(--bg);
    color: var(--primary);
  }
</style>