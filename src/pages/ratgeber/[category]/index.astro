---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories } from '../../../data/categories/index.js';

export function getStaticPaths() {
  return categories.map(cat => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const breadcrumbs = [
  { label: 'Start', url: '/' },
  { label: 'Ratgeber', url: '/ratgeber/' },
  { label: category.name }
];
---

<BaseLayout
  title={`Ratgeber: Konflikte mit ${category.name}`}
  description={`Hintergründe und psychologische Dynamiken zu Konflikten mit ${category.name}.`}
>
  <Breadcrumbs crumbs={breadcrumbs} />

  <section>
    <div class="cat-header">
      <span class="cat-icon">{category.icon}</span>
      <h1>Ratgeber: {category.name}</h1>
    </div>
    <p class="cat-desc">Hintergründe und psychologische Dynamiken zu typischen Konflikten mit {category.name}.</p>

    <div class="conflict-grid">
      {
        category.conflicts.map(con => (
          <a href={`${baseUrl}/ratgeber/${category.id}/${con.slug}/`} class="conflict-card">
            <span class="con-icon">{con.icon}</span>
            <div class="con-content">
              <span class="con-title">{con.article?.title || con.title}</span>
              <span class="con-summary">{con.summary}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .cat-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .cat-icon {
    font-size: 2.2rem;
  }
  .cat-header h1 {
    margin: 0;
  }
  .cat-desc {
    color: var(--text-light);
    margin-bottom: 2rem;
  }
  .conflict-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .conflict-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all 0.15s;
    color: var(--text);
    text-decoration: none;
  }
  .conflict-card:hover {
    border-color: var(--primary-light);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  .con-icon {
    font-size: 1.5rem;
    margin-top: 0.1rem;
  }
  .con-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .con-title {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
  }
  .con-summary {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.5;
  }
</style>