---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllConflicts } from '../data/categories/index.js';
import { methods } from '../data/methods/index.js';
import { topics } from '../data/topics/index.js';
import { scenarios } from '../data/trainer.js';
import { vorlagen } from '../data/vorlagen.js';
import { glossar } from '../data/glossar.js';
import { categories } from '../data/categories/index.js';
import { OPERATOR, PERSON_ID } from '../config/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const conflictCount = getAllConflicts().length;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Über Konfliktlotse',
  url: `${Astro.site!.origin}${baseUrl}/ueber-uns/`,
  inLanguage: 'de-DE',
  mainEntity: {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: OPERATOR.name,
    url: `${Astro.site!.origin}${baseUrl}/ueber-uns/`,
    address: { '@type': 'PostalAddress', addressLocality: 'München', addressCountry: 'DE' },
  },
  about: { '@type': 'WebSite', name: 'Konfliktlotse', url: `${Astro.site!.origin}${baseUrl}/` },
});
---
<BaseLayout
  title="Über uns"
  jsonLd={jsonLd}
  description="Wer hinter Konfliktlotse steht, wie unsere Gesprächspläne und Ratgeber entstehen, nach welchen Grundsätzen wir schreiben und wo die Grenzen des Angebots liegen."
>
  <article class="page">
    <h1>Über Konfliktlotse</h1>
    <p class="lead">
      Konfliktlotse hilft dir, schwierige Gespräche im Alltag zu führen – mit konkreten Worten statt
      allgemeiner Tipps. Ob Streit um den Haushalt, ein Chef, der kein Feedback gibt, oder Eltern, die
      sich einmischen: Du findest hier einen Plan, den du heute noch umsetzen kannst.
    </p>

    <h2>Was du hier findest</h2>
    <ul>
      <li><strong>{conflictCount} Gesprächspläne</strong> in {categories.length} Lebensbereichen – von Partnerschaft,
        Job und Familie über Nachbarschaft und WG bis zu Ex-Partner:in, Kindern und Vermieter:in – jeweils mit drei
        Formulierungsvarianten, Ablauf, Antworten auf Gegenreaktionen und einer klaren Grenze.</li>
      <li><strong>{conflictCount} Ratgeberartikel</strong>, die erklären, warum solche Konflikte entstehen
        und was langfristig hilft.</li>
      <li><strong>{methods.length} Methoden</strong> wie Ich-Botschaften, aktives Zuhören oder das
        Harvard-Konzept – verständlich erklärt, mit Beispielen und Grenzen.</li>
      <li><strong>{topics.length} Themen-Ratgeber</strong> zu großen Fragen wie Streit an Weihnachten, Mobbing
        am Arbeitsplatz oder Trennung im Guten.</li>
      <li><strong>Drei Übungen:</strong> den Gesprächs-Trainer mit {scenarios.length} Situationen, den
        Eskalations-Check und den Konflikttyp-Test.</li>
      <li><strong>{vorlagen.length} Vorlagen zum Ausdrucken</strong> und ein Glossar mit {glossar.length} Begriffen.</li>
    </ul>

    <h2>Unsere Grundsätze</h2>
    <ul>
      <li><strong>Konkret statt allgemein:</strong> Jeder Plan enthält Sätze, die du wörtlich sagen kannst.</li>
      <li><strong>Beide Seiten ernst nehmen:</strong> Wir beschreiben Perspektiven, ohne Ferndiagnosen über
        dein Gegenüber zu stellen.</li>
      <li><strong>Sicherheit vor Harmonie:</strong> Gewalt, Drohungen, Kontrolle oder Stalking sind keine
        Kommunikationsprobleme. Wo solche Themen berührt werden, weisen wir deutlich auf
        <a href={`${baseUrl}/hilfe-in-krisen/`}>Hilfe in Krisen</a> hin.</li>
      <li><strong>Datensparsam:</strong> Du musst nichts eingeben, dich nicht anmelden und keine
        Konfliktdetails preisgeben.</li>
      <li><strong>Ehrlich über Grenzen:</strong> Konfliktlotse ersetzt keine Beratung, Therapie, Mediation
        oder Rechtsberatung.</li>
    </ul>

    <h2>Wie unsere Inhalte entstehen</h2>
    <p>
      Die Texte werden redaktionell erstellt und mit Unterstützung von KI-Werkzeugen ausgearbeitet. Grundlage
      sind etablierte Ansätze aus Kommunikation und Konfliktlösung – etwa Ich-Botschaften nach Thomas Gordon,
      Gewaltfreie Kommunikation nach Marshall B. Rosenberg oder das Harvard-Konzept. Jeder Text folgt festen
      Qualitätsregeln: keine erfundenen Studien oder Zahlen, keine Rechtsauskünfte, verlässliche und geprüfte
      Notrufnummern. Jede Seite zeigt, wann sie zuletzt aktualisiert wurde.
    </p>
    <p>
      Wenn dir ein Fehler auffällt oder eine Formulierung in der Praxis nicht funktioniert hat, sag uns
      Bescheid – wir überarbeiten Inhalte laufend.
    </p>

    <h2>Wer dahintersteht</h2>
    <p>
      Konfliktlotse ist ein unabhängiges Projekt von {OPERATOR.name} aus München. Das Angebot ist kostenlos
      und soll es bleiben.
    </p>
    <p>
      <a href={`${baseUrl}/kontakt/`}>Kontakt aufnehmen</a> · <a href={`${baseUrl}/impressum/`}>Impressum</a>
    </p>
  </article>
</BaseLayout>

<style>
  .page { max-width: 68ch; }
  .lead { font-size: 1.1rem; }
  .page p, .page li { color: var(--text-light); line-height: 1.7; }
  .page ul { padding-left: 1.25rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .page a { text-decoration: underline; }
</style>
