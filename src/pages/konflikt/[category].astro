---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categories } from '../../data/categories/index.js';
import { getHub } from '../../data/hubs/index.js';
import { scenarios } from '../../data/trainer.js';
import { getTopic } from '../../data/topics/index.js';

export function getStaticPaths() {
  return categories.map(cat => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const hub = getHub(category.id);
const hubTopic = hub?.topic ? getTopic(hub.topic) : null;
const trainerCount = scenarios.filter(sc => sc.conflict.category === category.id).length;
const h1 = hub?.toolTitle || `Konflikte mit ${category.name}`;
const breadcrumbs = [
  { label: 'Start', url: '/' },
  { label: 'Konflikte', url: '/konflikt/' },
  { label: category.name },
];
---

<BaseLayout
  title={h1}
  fullTitle={`${h1.split(':')[0]} | Konfliktlotse`}
  description={hub?.toolMeta || category.summary}
>
  <Breadcrumbs crumbs={breadcrumbs} />
  <section>
    <div class="cat-header">
      <span class="cat-icon" aria-hidden="true">{category.icon}</span>
      <h1>{h1}</h1>
    </div>
    {hub ? hub.toolIntro.map((para: string) => <p class="cat-desc">{para}</p>) : <p class="cat-desc">{category.summary}</p>}

    <p class="section-label">Wähle dein Problem:</p>

    <div class="conflict-grid">
      {
        category.conflicts.map(con => (
          <a href={`${baseUrl}/konflikt/${category.id}/${con.slug}/`} class="conflict-card">
            <span class="con-icon">{con.icon}</span>
            <span class="con-title">{con.title}</span>
            <span class="con-summary">{con.summary}</span>
          </a>
        ))
      }
    </div>

    {hub?.quickTips?.length > 0 && (
      <aside class="quick-tips">
        <h2>Drei Sofort-Tipps</h2>
        <ol>{hub.quickTips.map((t: string) => <li>{t}</li>)}</ol>
      </aside>
    )}

    {hubTopic && (
      <p class="hub-crosslink">
        Den großen Überblick findest du im Themen-Ratgeber
        <a href={`${baseUrl}/themen/${hubTopic.slug}/`}>{hubTopic.title}</a>.
      </p>
    )}

    {trainerCount > 0 && (
      <a class="trainer-link" href={`${baseUrl}/spiel/gespraechstrainer/#bereich-${category.id}`}>
        🎯 <strong>Üben:</strong> {trainerCount} typische Situationen mit {category.name} im Gesprächs-Trainer
      </a>
    )}

    <AdSlot placement="list" />

    <p class="hub-crosslink">
      Du willst verstehen, warum diese Konflikte entstehen?
      <a href={`${baseUrl}/ratgeber/${category.id}/`}>Zum Ratgeber {category.name} →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .quick-tips { background: #F0F7F4; border-radius: var(--radius); padding: 1.1rem 1.4rem; margin: 2rem 0 1rem; }
  .quick-tips h2 { margin-top: 0; font-size: 1.1rem; }
  .quick-tips ol { padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .quick-tips li { color: var(--text-light); }
  .trainer-link { display: block; background: #FFF3E0; border: 1px solid #FFE0B2; border-radius: var(--radius-sm); padding: 0.9rem 1.1rem; color: var(--text); margin: 1rem 0; }
  .trainer-link:hover { border-color: var(--accent); color: var(--text); }
  .hub-crosslink { margin-top: 1.5rem; color: var(--text-light); }
  .hub-crosslink a { font-weight: 600; text-decoration: underline; }
  .back-link {
    display: inline-block;
    color: var(--text-light);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .back-link:hover {
    color: var(--primary);
  }
  .cat-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .cat-icon {
    font-size: 1.9rem;
    line-height: 1.2;
  }
  .cat-header h1 {
    margin: 0;
  }
  .cat-desc {
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }
  .section-label {
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--text-light);
  }
  .conflict-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .conflict-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all 0.15s;
    color: var(--text);
  }
  .conflict-card:hover {
    border-color: var(--primary-light);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  .con-icon {
    font-size: 1.5rem;
  }
  .con-title {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .con-summary {
    font-size: 0.85rem;
    color: var(--text-light);
  }
</style>
