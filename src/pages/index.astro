---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories/index.js';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Startseite" description="Alltagskonflikte lösen – dein Lotse für schwierige Gespräche. Wähle deinen Konflikt und finde den richtigen Weg.">
  <section class="hero">
    <h1>Kleine Konflikte.<br />Große Wirkung.</h1>
    <p class="hero-sub">
      Der Lotse für deinen nächsten schwierigen Moment.
      Wähle deine Situation und finde Schritt für Schritt
      den Weg zur Lösung.
    </p>
    <div class="hero-actions">
      <a href={`${baseUrl}/konflikt/`} class="btn btn-primary">
        Konflikt lösen →
      </a>
      <a href={`${baseUrl}/ratgeber/`} class="btn btn-outline">
        Zum Ratgeber
      </a>
    </div>
  </section>

  <section class="categories-preview">
    <h2>Für wen ist der Konflikt?</h2>
    <div class="category-grid">
      {
        categories.map(cat => (
          <a href={`${baseUrl}/konflikt/${cat.id}/`} class="category-card">
            <span class="cat-icon">{cat.icon}</span>
            <span class="cat-name">{cat.name}</span>
            <span class="cat-count">{cat.conflicts.length} Konflikte</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="how-it-works">
    <h2>So funktioniert's</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p><strong>Wer?</strong> Wähle, mit wem der Konflikt ist.</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p><strong>Was?</strong> Wähle das genaue Problem.</p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p><strong>Wie?</strong> Wähle: allein lösen oder beide Seiten?</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.2rem;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }
  .hero-sub {
    color: var(--text-light);
    font-size: 1.05rem;
    max-width: 500px;
    margin: 0 auto 2rem;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.15s;
    border: none;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--text);
  }
  .btn-primary:hover {
    background: var(--accent-light);
    color: var(--text);
    transform: translateY(-1px);
  }
  .btn-outline {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
  }
  .btn-outline:hover {
    background: var(--primary);
    color: white;
  }
  .categories-preview {
    padding: 2rem 0;
  }
  .categories-preview h2 {
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 500px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .category-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1rem;
    text-align: center;
    transition: all 0.15s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .category-card:hover {
    border-color: var(--primary-light);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .cat-icon {
    font-size: 2rem;
  }
  .cat-name {
    font-weight: 600;
    color: var(--text);
  }
  .cat-count {
    font-size: 0.8rem;
    color: var(--text-light);
  }
  .how-it-works {
    padding: 2rem 0;
  }
  .how-it-works h2 {
    margin-bottom: 1.25rem;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
  }
  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .step p {
    color: var(--text-light);
  }
</style>
