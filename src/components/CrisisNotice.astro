---
export interface Props {
  /** Konfliktspezifischer Sicherheitstext (Feld `safety`), ganzer Absatz. */
  context?: string;
}

const { context } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const hilfeUrl = `${baseUrl}/hilfe-in-krisen/`.replace(/\/\/+/g, '/');
---
<aside class="crisis-notice" aria-label="Sicherheitshinweis">
  {context ? (
    <>
      <p class="crisis-title"><strong>Ist das noch ein Alltagskonflikt?</strong></p>
      <p>{context}</p>
      <p class="crisis-link">Bei Gewalt, Bedrohung oder Angst: <a href={hilfeUrl}>Hilfe in Krisen finden</a> · Notruf 110</p>
    </>
  ) : (
    <p>
      <strong>Wichtig:</strong> Bei Gewalt, Bedrohung oder Angst helfen keine Gesprächsregeln.
      Wende dich an Profis. <a href={hilfeUrl}>Hilfe in Krisen finden</a>
    </p>
  )}
</aside>

<style>
  .crisis-notice {
    background: #FFF3CD;
    border-left: 4px solid #FFC107;
    padding: 1rem;
    margin: 1.5rem 0;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: #664D03;
    line-height: 1.5;
  }
  .crisis-notice p { margin: 0 0 0.5rem; color: #664D03; }
  .crisis-notice p:last-child { margin-bottom: 0; }
  .crisis-notice a {
    color: #7a5a00;
    font-weight: 600;
    text-decoration: underline;
  }
  .crisis-notice a:hover {
    color: #664D03;
  }
  .crisis-notice strong {
    color: #7a5a00;
  }
</style>
