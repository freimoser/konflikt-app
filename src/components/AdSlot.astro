---
// Dezenter, gekennzeichneter Anzeigenplatz. Rendert nur, wenn AdSense per
// Umgebungsvariable aktiviert ist, für die Platzierung eine Block-ID existiert
// und die Seite nicht als sensibel markiert ist. Sonst: gar nichts (keine leeren Plätze).
import { ADS_ENABLED, ADSENSE_CLIENT, AD_SLOTS, type AdPlacement } from '../config/site';

export interface Props {
  placement: AdPlacement;
  /** true auf Seiten/Abschnitten mit sensiblen Inhalten (Krise, Gewalt, Kontrolle). */
  sensitive?: boolean;
}

const { placement, sensitive = false } = Astro.props;
const slot = AD_SLOTS[placement];
const show = ADS_ENABLED && !sensitive && /^\d{6,}$/.test(slot);
---
{show && (
  <aside class="ad-slot" aria-label="Anzeige">
    <span class="ad-label">Anzeige</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  .ad-slot {
    margin: 2rem 0;
    min-height: 280px; /* reservierter Platz gegen Layout-Verschiebung */
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }
  .ad-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: 0.25rem;
  }
</style>
