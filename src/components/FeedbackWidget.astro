---
export interface Props {
  slug: string;
}

const { slug } = Astro.props;
---
<div class="feedback-widget">
  <p>War diese Seite hilfreich?</p>
  <div class="feedback-actions">
    <a href={`mailto:91Serdar@gmail.com?subject=Feedback Konfliktlotse: ${slug}&body=War diese Seite hilfreich? Ja.`} class="feedback-btn" aria-label="Ja, war hilfreich">👍 Ja</a>
    <a href={`mailto:91Serdar@gmail.com?subject=Feedback Konfliktlotse: ${slug}&body=War diese Seite hilfreich? Nein.`} class="feedback-btn" aria-label="Nein, war nicht hilfreich">👎 Nein</a>
  </div>
  <p class="feedback-hint">Öffnet dein E-Mail-Programm. Wir speichern keine Daten im Browser.</p>
</div>

<style>
  .feedback-widget {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
    margin: 2.5rem 0;
  }
  .feedback-widget p {
    margin: 0;
    font-weight: 500;
  }
  .feedback-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .feedback-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 500;
    transition: all 0.2s;
    text-decoration: none;
  }
  .feedback-btn:hover {
    background: var(--border);
    color: var(--text);
  }
  .feedback-hint {
    font-size: 0.75rem !important;
    color: var(--text-light) !important;
    margin-top: 1rem !important;
    font-weight: 400 !important;
  }
</style>
