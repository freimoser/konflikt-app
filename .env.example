# Kopiere nach .env (wird nicht committet) oder setze als GitHub-Actions-Variablen
# (Settings → Secrets and variables → Actions → Variables). Leer = Funktion ist komplett aus.

# Google AdSense: leer → keine Werbung, kein ads.txt, kein Werbe-Abschnitt im Datenschutz.
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
# PUBLIC_ADSENSE_SLOT_AFTER_TOOL=
# PUBLIC_ADSENSE_SLOT_LIST=

# Google Analytics 4 (Mess-ID „G-…“): leer → kein Banner, kein GA, kein GA-Abschnitt im Datenschutz.
# Gesetzt → Einwilligungsbanner; GA lädt erst nach „Zustimmen“.
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics (Site-Token, 32 Hex-Zeichen, manuelle Einrichtung im Cloudflare-Dashboard):
# leer → keine Messung. Gesetzt → cookielose Zählung ohne Banner + Abschnitt im Datenschutz.
# PUBLIC_CF_ANALYTICS_TOKEN=
